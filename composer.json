{
  "name": "naf/auth-ldap",
  "description": "Optional TLS LDAP provider using the existing NAF Auth contract.",
  "type": "naf-plugin",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "ext-ldap": "*",
    "naf/auth": "^0.2"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "3.95.25"
  },
  "autoload": {
    "psr-4": {
      "Naf\\Auth\\Ldap\\": "src/"
    }
  },
  "scripts": {
    "test": "@php tests/run.php",
    "style:check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
    "style:fix": "@php vendor/bin/php-cs-fixer fix"
  },
  "config": {
    "allow-plugins": false,
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  }
}
